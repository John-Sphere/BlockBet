/* ─────────────────────────────────────────────────────
   BLOCKBET Football Page
───────────────────────────────────────────────────── */

/* ── HERO ──────────────────────────────────────────── */
.fp__hero {
  position: relative;
  overflow: hidden;
  padding: 48px 48px 44px;
  background: linear-gradient(135deg, #050608 0%, #08111F 60%, #0D1728 100%);
  border-bottom: 1px solid var(--border);
  min-height: 280px;
  display: flex;
  align-items: center;
}

.fp__hero-grid {
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 64px 64px;
  opacity: 0.18;
}

.fp__hero-orb {
  position: absolute; border-radius: 50%;
  filter: blur(60px); pointer-events: none;
  animation: pulse 6s ease-in-out infinite;
}
.fp__hero-orb--1 {
  width: 600px; height: 600px;
  top: -200px; right: -200px;
  background: radial-gradient(circle, rgba(46,199,242,0.12) 0%, transparent 70%);
}
.fp__hero-orb--2 {
  width: 400px; height: 400px;
  bottom: -150px; left: -100px;
  background: radial-gradient(circle, rgba(0,207,255,0.07) 0%, transparent 70%);
  animation-delay: 2s;
}

.fp__hero-ring {
  position: absolute; border-radius: 50%;
  border: 1px solid rgba(46,199,242,0.07);
  pointer-events: none;
}
.fp__hero-ring--1 {
  width: 500px; height: 500px;
  top: 50%; right: -60px;
  transform: translateY(-50%);
  animation: spin 28s linear infinite;
}
.fp__hero-ring--2 {
  width: 320px; height: 320px;
  top: 50%; right: 60px;
  transform: translateY(-50%);
  animation: spin 20s linear infinite reverse;
}

.fp__hero-content {
  position: relative; z-index: 2;
  max-width: 640px;
}

.fp__hero-brand {
  display: flex; align-items: center;
  gap: 12px; margin-bottom: 16px;
}
.fp__hero-logo {
  width: 50px; height: 50px; border-radius: 12px; flex-shrink: 0;
  background: linear-gradient(135deg, #2EC7F2, #47D7FF);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 26px rgba(46,199,242,0.4);
}
.fp__hero-name    { font-size: 22px; font-weight: 900; letter-spacing: 1.2px; }
.fp__hero-tagline { font-size: 9px; color: var(--muted); letter-spacing: 3px; font-weight: 600; }

.fp__hero-h1 {
  font-size: clamp(24px, 4vw, 46px);
  font-weight: 900; line-height: 1.1;
  letter-spacing: -1px; margin-bottom: 12px;
}
.fp__hero-p {
  font-size: 14px; color: var(--gray);
  line-height: 1.7; margin-bottom: 22px;
  max-width: 500px;
}

.fp__hero-stats    { display: flex; gap: 28px; flex-wrap: wrap; }
.fp__hero-stat     {}
.fp__hero-stat-val {
  display: block; font-size: 24px; font-weight: 900; color: var(--primary);
  text-shadow: 0 0 16px rgba(46,199,242,0.35);
}
.fp__hero-stat-lbl {
  display: block; font-size: 9px; color: var(--muted);
  letter-spacing: 2px; font-weight: 700; margin-top: 2px;
}

/* ── FILTERS ───────────────────────────────────────── */
.fp__filters-wrap {
  padding: 12px 24px; background: var(--bg2);
  border-bottom: 1px solid var(--border);
  display: flex; flex-direction: column; gap: 8px;
}
.fp__filter-row {
  display: flex; gap: 6px; overflow-x: auto;
  padding-bottom: 2px;
}

.fp__flt {
  background: var(--glass); border: 1px solid var(--border);
  color: var(--muted); padding: 6px 14px; border-radius: 20px;
  font-size: 12px; font-weight: 600; white-space: nowrap;
  flex-shrink: 0; transition: var(--ease);
}
.fp__flt:hover  { color: var(--gray); }
.fp__flt--on    {
  background: rgba(46,199,242,0.12) !important;
  color: var(--primary) !important;
  border-color: var(--borderh) !important;
  font-weight: 700 !important;
}

.fp__league {
  background: var(--glass); border: 1px solid var(--border);
  color: var(--muted); padding: 6px 14px; border-radius: 20px;
  font-size: 12px; font-weight: 500; white-space: nowrap;
  flex-shrink: 0; transition: var(--ease);
}
.fp__league:hover { color: var(--gray); }
.fp__league--on   {
  background: linear-gradient(135deg, #2EC7F2, #47D7FF) !important;
  color: #050608 !important; border-color: transparent !important;
  font-weight: 700 !important;
  box-shadow: 0 0 16px rgba(46,199,242,0.25);
}

/* ── MAIN LAYOUT ───────────────────────────────────── */
.fp__main {
  display: flex; gap: 20px; padding: 24px 28px;
  align-items: flex-start; max-width: 1400px; margin: 0 auto;
}
.fp__cards     { flex: 1; min-width: 0; }
.fp__slip-desk {
  width: 308px; flex-shrink: 0;
  position: sticky; top: calc(var(--nav-h) + 16px);
}

/* ── MATCH CARD ────────────────────────────────────── */
.mc             { overflow: hidden; transition: var(--ease); }
.mc--live       { border-color: rgba(16,233,129,0.28) !important; box-shadow: 0 0 22px rgba(16,233,129,0.07) !important; }
.mc--done       { opacity: 0.88; }

.mc__head {
  display: flex; align-items: center; gap: 7px;
  padding: 10px 16px; border-bottom: 1px solid var(--border);
  background: rgba(46,199,242,0.02); flex-wrap: wrap;
}
.mc__league    { font-size: 11px; color: var(--primary); font-weight: 700; letter-spacing: 0.4px; flex: 1; min-width: 0; }
.mc__min       { font-size: 12px; color: #10E981; font-weight: 800; }
.mc__ht        { font-size: 11px; color: var(--muted); }
.mc__pool      {
  font-size: 10px; color: #10E981; font-weight: 700;
  background: rgba(16,233,129,0.08); border: 1px solid rgba(16,233,129,0.2);
  padding: 2px 8px; border-radius: 6px;
}
.mc__countdown {
  font-size: 11px; font-weight: 700; color: var(--warning);
  background: rgba(255,200,87,0.08); border: 1px solid rgba(255,200,87,0.2);
  padding: 2px 8px; border-radius: 6px;
}
.mc__countdown--urgent { color: var(--danger) !important; background: rgba(255,77,109,0.08) !important; border-color: rgba(255,77,109,0.25) !important; }

.mc__body      { padding: 16px; }
.mc__teams     { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.mc__team      { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; }
.mc__team--r   { flex-direction: row-reverse; }
.mc__logo      { width: 28px; height: 28px; object-fit: contain; flex-shrink: 0; }
.mc__name      { font-size: 14px; font-weight: 700; color: var(--white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mc__center    { text-align: center; flex-shrink: 0; min-width: 68px; }
.mc__vs        { font-size: 13px; color: var(--muted); font-weight: 700; }
.mc__score     { font-size: 22px; font-weight: 900; letter-spacing: 2px; }
.mc__score-sep { color: var(--muted); font-size: 16px; }

/* Odds */
.mc__odds      { display: flex; gap: 7px; }
.mc__odd       {
  flex: 1; padding: 10px 4px; text-align: center;
  background: rgba(46,199,242,0.05); border: 1px solid var(--border);
  border-radius: 12px; cursor: pointer; transition: var(--ease);
}
.mc__odd:hover { background: rgba(46,199,242,0.11); border-color: var(--borderh); }
.mc__odd--on   {
  background: linear-gradient(135deg, #2EC7F2, #47D7FF) !important;
  border-color: transparent !important;
  box-shadow: 0 0 20px rgba(46,199,242,0.28) !important;
}
.mc__odd-l     { display: block; font-size: 9px; font-weight: 800; color: var(--muted); margin-bottom: 3px; letter-spacing: 0.4px; }
.mc__odd-v     { display: block; font-size: 17px; font-weight: 900; }
.mc__odd-s     { display: block; font-size: 9px; color: var(--muted); }
.mc__odd--on .mc__odd-l,
.mc__odd--on .mc__odd-v,
.mc__odd--on .mc__odd-s { color: #050608 !important; }

.mc__live-odds {
  display: flex; gap: 14px; justify-content: center;
  align-items: center; font-size: 13px; color: var(--muted);
  padding: 8px 0;
}
.mc__result    { display: flex; align-items: center; justify-content: space-between; padding: 10px 0 2px; }
.mc__result-text { font-size: 14px; font-weight: 700; color: var(--warning); }

.mc__goals     {
  padding: 8px 16px; border-top: 1px solid var(--border);
  display: flex; flex-wrap: wrap; gap: 8px;
  background: rgba(16,233,129,0.02);
}
.mc__goal      { font-size: 12px; color: #10E981; font-weight: 600; }

.mc__stats-btn {
  width: 100%; padding: 9px; font-size: 11px;
  color: var(--muted); background: none; border: none;
  border-top: 1px solid var(--border); cursor: pointer;
  transition: var(--ease);
}
.mc__stats-btn:hover { color: var(--primary); background: rgba(46,199,242,0.03); }

.mc__stats     { padding: 12px 16px; border-top: 1px solid var(--border); }
.mc__stat-row  {
  display: grid; grid-template-columns: 64px 1fr 64px;
  gap: 8px; align-items: center; font-size: 12px; margin-bottom: 7px;
}

/* ── BET SLIP ──────────────────────────────────────── */
.slip {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 18px; overflow: hidden;
  display: flex; flex-direction: column;
}

.slip__head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 18px; border-bottom: 1px solid var(--border);
  background: rgba(46,199,242,0.03);
}
.slip__head-left { display: flex; align-items: center; gap: 8px; }
.slip__dot       { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); transition: var(--ease); }
.slip__dot--on   { background: #10E981 !important; box-shadow: 0 0 8px #10E981; }
.slip__title     { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
.slip__count     {
  background: var(--primary); color: #050608;
  width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 800;
}
.slip__clear     {
  background: rgba(255,77,109,0.09); border: 1px solid rgba(255,77,109,0.25);
  color: var(--danger); padding: 4px 10px; border-radius: 8px;
  font-size: 11px; font-weight: 600;
}
.slip__close     {
  background: var(--glass); border: 1px solid var(--border);
  color: var(--muted); width: 28px; height: 28px;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 13px;
}

.slip__body {
  flex: 1; overflow-y: auto; padding: 14px;
  max-height: calc(100vh - 240px);
}

.slip__empty      { text-align: center; padding: 44px 0; color: var(--muted); display: flex; flex-direction: column; gap: 6px; align-items: center; }
.slip__empty-icon { font-size: 38px; }
.slip__empty-title{ font-size: 14px; font-weight: 600; color: var(--gray); }
.slip__empty-sub  { font-size: 12px; }

.slip__item {
  background: rgba(13,23,40,0.65); border: 1px solid var(--border);
  border-radius: 12px; padding: 12px 14px; margin-bottom: 8px;
  display: flex; justify-content: space-between;
  align-items: flex-start; gap: 8px;
}
.slip__item-info  { flex: 1; }
.slip__item-match { display: block; font-size: 12px; font-weight: 700; margin-bottom: 3px; }
.slip__item-pick  { display: block; font-size: 11px; color: var(--primary); }
.slip__item-right { display: flex; align-items: center; gap: 8px; }
.slip__item-odds  { font-size: 17px; font-weight: 900; color: var(--primary); }
.slip__item-del   { background: none; border: none; color: var(--danger); font-size: 16px; }

/* Stake */
.slip__stake           { margin: 12px 0; }
.slip__stake-label     { display: block; font-size: 10px; color: var(--muted); font-weight: 700; letter-spacing: 1px; margin-bottom: 7px; }
.slip__stake-input-wrap{ position: relative; }
.slip__stake-input     {
  width: 100%; padding: 12px 46px 12px 14px;
  border-radius: 12px; border: 1px solid var(--border);
  background: rgba(13,23,40,0.65); color: var(--white);
  font-size: 15px; transition: var(--ease);
}
.slip__stake-input:focus { border-color: var(--borderh); box-shadow: 0 0 16px rgba(46,199,242,0.12); }
.slip__stake-input--err  { border-color: rgba(255,77,109,0.5) !important; }
.slip__stake-currency    {
  position: absolute; right: 13px; top: 50%;
  transform: translateY(-50%); font-size: 12px;
  color: var(--muted); font-weight: 700; pointer-events: none;
}

.slip__bal-row {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; color: var(--muted); margin-top: 6px;
}
.slip__bal-row strong { color: var(--primary); }
.slip__max-btn {
  margin-left: auto; background: var(--glass); border: 1px solid var(--border);
  color: var(--primary); padding: 2px 7px; border-radius: 4px;
  font-size: 10px; font-weight: 700;
}
.slip__bal-err { font-size: 11px; color: var(--danger); margin-top: 5px; font-weight: 600; }

/* Summary */
.slip__summary    {
  background: rgba(13,23,40,0.65); border: 1px solid var(--border);
  border-radius: 12px; padding: 14px; margin-bottom: 14px;
}
.slip__sum-row    { display: flex; justify-content: space-between; font-size: 13px; color: var(--gray); margin-bottom: 8px; }
.slip__sum-row:last-child { margin-bottom: 0; }
.slip__sum-divider{ height: 1px; background: var(--border); margin: 10px 0; }
.slip__sum-win    { font-size: 20px; color: #10E981; }
.slip__sum-usdc   { font-size: 13px; color: var(--muted); font-weight: 600; }

.slip__footer-note { text-align: center; margin-top: 10px; font-size: 11px; color: var(--muted); }

/* ── MOBILE SLIP + FAB ─────────────────────────────── */
.fp__slip-mob {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 400;
  border-radius: 20px 20px 0 0; max-height: 85vh; overflow-y: auto;
  box-shadow: 0 -8px 40px rgba(46,199,242,0.14);
  animation: fadeUp 0.25s ease;
}
.fp__fab {
  position: fixed; bottom: 20px; right: 20px; z-index: 300;
  background: linear-gradient(135deg, #2EC7F2, #47D7FF);
  color: #050608; border: none; padding: 13px 22px;
  border-radius: 50px; font-size: 13px; font-weight: 800;
  box-shadow: 0 0 36px rgba(46,199,242,0.35);
  display: flex; align-items: center; gap: 6px;
  animation: glow-beat 2s ease-in-out infinite;
}
.fp__fab-win { font-size: 11px; opacity: 0.85; }

/* ── RESPONSIVE ────────────────────────────────────── */
@media (max-width: 1100px) {
  .fp__slip-desk { display: none; }
  .fp__main      { padding: 16px; }
}
@media (max-width: 768px) {
  .fp__hero       { padding: 32px 16px 28px; min-height: auto; }
  .fp__hero-h1    { font-size: 22px; }
  .fp__hero-stats { gap: 16px; }
  .fp__hero-stat-val { font-size: 20px; }
  .fp__hero-ring--1, .fp__hero-ring--2 { display: none; }
  .fp__filters-wrap { padding: 10px 14px; }
  .mc__name       { font-size: 12px; }
  .mc__score      { font-size: 18px; }
  .mc__odd        { padding: 8px 2px; }
  .mc__odd-v      { font-size: 14px; }
  .slip__body     { max-height: 62vh; }
}